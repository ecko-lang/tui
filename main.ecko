# tui - terminal styling and UI composition for Ecko, written in Ecko.
#
# Two halves. Styling: colours, attributes, hyperlinks and cursor/clear
# sequences, which moved here from std.term in Ecko 0.59 under the same names.
# Each emits escape codes only when term.color_enabled() says to (CLICOLOR_FORCE,
# NO_COLOR, then whether stdout is a terminal) - the one check a package cannot
# make itself without the env capability. Composition: width-aware padding,
# boxes and tables, where widths count what the EYE sees (escape codes take no
# columns), so coloured content still lines up. No capabilities; Layer 3, per
# core-slim-design section 5.

import std.term
import std.str
import "./columns.ecko"

ESC = "\u{1b}"

# --- styling ---------------------------------------------------------------
# sgr() wraps text in a Select Graphic Rendition code and resets after;
# control() is a bare sequence. Both are plain (or empty) when colour is off.

fn sgr(codes, text) {
    t = string(text)
    if codes != "" and term.color_enabled() { ESC + "[" + codes + "m" + t + ESC + "[0m" } else { t }
}

fn control(seq) = if term.color_enabled() { seq } else { "" }

fn clamp(n, lo, hi) = min([hi, max([lo, n])])

COLORS = {
    black: 30,
    red: 31,
    green: 32,
    yellow: 33,
    blue: 34,
    magenta: 35,
    cyan: 36,
    white: 37,
    gray: 90,
    grey: 90,
    bright_black: 90,
    bright_red: 91,
    bright_green: 92,
    bright_yellow: 93,
    bright_blue: 94,
    bright_magenta: 95,
    bright_cyan: 96,
    bright_white: 97,
}

fn color_code(name, offset) {
    code = get(COLORS, name)
    if is_null(code) {
        error(
            {
                kind: "bug",
                reason: "bad_option",
                message: "tui.style: unknown color '{name}'; use one of {join(sort(keys(COLORS)), ", ")}",
            },
        )
    }
    string(code + offset)
}

## `text` in black. Every colour and attribute function takes any value
## (non-strings are stringified) and returns it unchanged when colour is off.
export fn black(text) = sgr("30", text)
## `text` in red.
export fn red(text) = sgr("31", text)
## `text` in green.
export fn green(text) = sgr("32", text)
## `text` in yellow.
export fn yellow(text) = sgr("33", text)
## `text` in blue.
export fn blue(text) = sgr("34", text)
## `text` in magenta.
export fn magenta(text) = sgr("35", text)
## `text` in cyan.
export fn cyan(text) = sgr("36", text)
## `text` in white.
export fn white(text) = sgr("37", text)
## `text` in gray (the same code as `grey` and `bright_black`).
export fn gray(text) = sgr("90", text)
## `text` in grey - an alias of `gray`.
export fn grey(text) = sgr("90", text)
## `text` in bright black - an alias of `gray`.
export fn bright_black(text) = sgr("90", text)
## `text` in bright red.
export fn bright_red(text) = sgr("91", text)
## `text` in bright green.
export fn bright_green(text) = sgr("92", text)
## `text` in bright yellow.
export fn bright_yellow(text) = sgr("93", text)
## `text` in bright blue.
export fn bright_blue(text) = sgr("94", text)
## `text` in bright magenta.
export fn bright_magenta(text) = sgr("95", text)
## `text` in bright cyan.
export fn bright_cyan(text) = sgr("96", text)
## `text` in bright white.
export fn bright_white(text) = sgr("97", text)

## `text` in bold.
export fn bold(text) = sgr("1", text)
## `text` dimmed.
export fn dim(text) = sgr("2", text)
## `text` in italics.
export fn italic(text) = sgr("3", text)
## `text` underlined.
export fn underline(text) = sgr("4", text)
## `text` blinking, where the terminal supports it.
export fn blink(text) = sgr("5", text)
## `text` with foreground and background swapped.
export fn reverse(text) = sgr("7", text)
## `text` struck through.
export fn strikethrough(text) = sgr("9", text)

## `text` in a 24-bit colour; each channel is clamped to 0-255.
export fn rgb(text, r: Int, g: Int, b: Int) = sgr(
    "38;2;{clamp(r, 0, 255)};{clamp(g, 0, 255)};{clamp(b, 0, 255)}",
    text,
)

## `text` in colour `n` of the 256-colour palette, clamped to 0-255.
export fn color(text, n: Int) = sgr("38;5;{clamp(n, 0, 255)}", text)

## `text` with several attributes and colours at once, given as named arguments.
##
## `fg` and `bg` take the colour names of the functions above (`"red"`,
## `"bright_cyan"`, `"gray"`, ...).
##
## errors: `bug`/`bad_option` for an unknown `fg` or `bg` name.
##
## example:
##   tui.style("ok", bold: true, fg: "green", bg: "black")
export fn style(text, bold = false, dim = false, italic = false, underline = false, blink = false, reverse = false, strikethrough = false, fg = null, bg = null) {
    mut codes = []
    flags = [
        [bold, "1"],
        [dim, "2"],
        [italic, "3"],
        [underline, "4"],
        [blink, "5"],
        [reverse, "7"],
        [strikethrough, "9"],
    ]
    for f in flags {
        if f[0] { codes = push(codes, f[1]) }
    }
    unless is_null(fg) { codes = push(codes, color_code(fg, 0)) }
    unless is_null(bg) { codes = push(codes, color_code(bg, 10)) }
    sgr(join(codes, ";"), text)
}

## `text` as a clickable hyperlink to `url` (OSC 8), or plain `text` when
## colour is off.
export fn link(url, text) {
    t = string(text)
    if term.color_enabled() {
        ESC + "]8;;" + string(url) + ESC + "\\" + t + ESC + "]8;;" + ESC + "\\"
    } else {
        t
    }
}

## Move the cursor to `row`, `col` (1-based; smaller values become 1).
export fn goto(row: Int, col: Int) = control(ESC + "[{max([1, row])};{max([1, col])}H")
## Move the cursor up `n` rows (default 1).
export fn up(n = 1) = control(ESC + "[{steps(n)}A")
## Move the cursor down `n` rows (default 1).
export fn down(n = 1) = control(ESC + "[{steps(n)}B")
## Move the cursor right `n` columns (default 1).
export fn right(n = 1) = control(ESC + "[{steps(n)}C")
## Move the cursor left `n` columns (default 1).
export fn left(n = 1) = control(ESC + "[{steps(n)}D")

fn steps(n) = if type_of(n) == "int" { max([1, n]) } else { 1 }

## Save the cursor position.
export fn save_cursor() = control(ESC + "[s")
## Restore the cursor position saved by `save_cursor`.
export fn restore_cursor() = control(ESC + "[u")
## Hide the cursor.
export fn hide_cursor() = control(ESC + "[?25l")
## Show the cursor.
export fn show_cursor() = control(ESC + "[?25h")
## Clear the screen and move the cursor home.
export fn clear() = control(ESC + "[2J" + ESC + "[H")
## Clear the current line.
export fn clear_line() = control(ESC + "[2K")
## Clear from the cursor to the end of the screen.
export fn clear_down() = control(ESC + "[0J")
## Switch to the alternate screen, or back with `alt_screen(false)`.
export fn alt_screen(on = true) = control(if on { ESC + "[?1049h" } else { ESC + "[?1049l" })

## `s` with its escape sequences removed - colours, cursor moves and
## hyperlinks - which is what a log file wants. Works whether or not colour is on.
export fn strip(s) {
    cs = str.chars(string(s))
    n = len(cs)
    mut out = []
    mut i = 0
    while i < n {
        c = cs[i]
        i = i + 1
        if c != ESC { out = push(out, c) } else if i < n and cs[i] == "[" {
            # CSI: ESC [ ... a final byte in @ to ~
            i = i + 1
            mut done = false
            while i < n and not done {
                o = str.ord(cs[i])
                i = i + 1
                done = o >= 64 and o <= 126
            }
        } else if i < n and cs[i] == "]" {
            # OSC: ESC ] ... ended by BEL or ESC \
            i = i + 1
            mut done = false
            while i < n and not done {
                d = cs[i]
                if d == "\u{7}" {
                    i = i + 1
                    done = true
                } else if d == ESC {
                    i = i + 1
                    if i < n and cs[i] == "\\" { i = i + 1 }
                    done = true
                } else { i = i + 1 }
            }
        }
    }
    join(out, "")
}

## The visible width of `s` in terminal columns.
##
## Escape sequences take no columns. CJK characters, fullwidth forms and emoji
## take two; combining marks, zero-width joiners and variation selectors take
## none; an emoji ZWJ sequence, a skin-tone emoji and a flag each count as one
## two-column glyph. A non-string is stringified first.
##
## example:
##   tui.width(tui.red("日本"))   # 4
export fn width(s) = columns.columns(strip(s))

# --- width-aware primitives ------------------------------------------------
# vis() is the VISIBLE column width; padding is measured against it, not bytes.

fn vis(s) = width(s)

fn spaces(n) = if n <= 0 { "" } else { str.repeat(" ", n) }

fn bug(reason, message) = error({ kind: "bug", reason: reason, message: message })

fn need_width(fname, w) {
    unless type_of(w) == "int" and w >= 0 {
        bug("bad_width", "tui.{fname}: w must be a non-negative Int, got {w}")
    }
}

## `s` padded on the right with spaces to a visible width of `w` columns.
##
## Text already `w` columns or wider comes back unchanged. A non-string is
## stringified first.
##
## errors: `bug`/`bad_width` when `w` is not a non-negative Int.
##
## example:
##   tui.pad_end("hi", 5)   # "hi   "
export fn pad_end(s, w) {
    need_width("pad_end", w)
    t = string(s)
    t + spaces(w - vis(t))
}

## `s` right-aligned in `w` columns by padding it on the left with spaces.
##
## Text already `w` columns or wider comes back unchanged. A non-string is
## stringified first.
##
## errors: `bug`/`bad_width` when `w` is not a non-negative Int.
##
## example:
##   tui.pad_start("42", 5)   # "   42"
export fn pad_start(s, w) {
    need_width("pad_start", w)
    t = string(s)
    spaces(w - vis(t)) + t
}

## `s` centred in `w` columns; an odd leftover space goes on the right.
##
## errors: `bug`/`bad_width` when `w` is not a non-negative Int.
##
## example:
##   tui.center("hi", 5)   # " hi  "
export fn center(s, w) {
    need_width("center", w)
    t = string(s)
    gap = max([0, w - vis(t)])
    lpad = gap // 2
    spaces(lpad) + t + spaces(gap - lpad)
}

## `s` cut to a visible width of `w` columns, the cut marked with `…`.
##
## Text that fits comes back unchanged. A cut never splits a wide character
## or a combining sequence. With `w` of 1 there is no room for the ellipsis,
## so the first column is kept alone; `w` of 0 gives `""`. A cut string loses
## its escape sequences, so truncate before colouring.
##
## errors: `bug`/`bad_width` when `w` is not a non-negative Int.
##
## example:
##   tui.truncate("hello world", 5)   # "hell…"
export fn truncate(s, w) {
    need_width("truncate", w)
    t = string(s)
    if vis(t) <= w { t } else {
        plain = strip(t)
        if w <= 1 {
            columns.take_columns(plain, w)
        } else {
            columns.take_columns(plain, w - 1) + "…"
        }
    }
}

# --- box -------------------------------------------------------------------

BORDERS = {
    rounded: { tl: "╭", tr: "╮", bl: "╰", br: "╯", h: "─", v: "│" },
    square: { tl: "┌", tr: "┐", bl: "└", br: "┘", h: "─", v: "│" },
    double: { tl: "╔", tr: "╗", bl: "╚", br: "╝", h: "═", v: "║" },
    heavy: { tl: "┏", tr: "┓", bl: "┗", br: "┛", h: "━", v: "┃" },
}

fn need_count(fname, name, v) {
    unless type_of(v) == "int" and v >= 0 {
        bug("bad_option", "tui.{fname}: {name} must be a non-negative Int, got {v}")
    }
}

## A bordered box around `lines`, as one string.
##
## `lines` is a list; each item is stringified, and one holding newlines
## becomes several rows. `border` is `"rounded"`, `"square"`, `"double"` or
## `"heavy"`; `title`, when given, sits in the top edge; `padding` is the
## spaces inside each vertical edge; `min_width` is the least total width of
## the box. The box grows to fit its widest line and its title.
##
## errors: `bug`/`bad_argument` when `lines` is not a list; `bug`/`bad_option`
## for an unknown `border` or a `padding` or `min_width` that is not a
## non-negative Int.
##
## example:
##   tui.box(["Ready to ship."], title: "Status")
##   # ╭─ Status ───────╮
##   # │ Ready to ship. │
##   # ╰────────────────╯
export fn box(lines, border = "rounded", title = null, padding = 1, min_width = 0) {
    unless type_of(lines) == "list" {
        bug("bad_argument", "tui.box: lines must be a list, got {type_of(lines)}")
    }
    if type_of(border) == "map" {
        bug(
            "bad_option",
            "tui.box: options are named arguments - write box(lines, border: \"square\"), not box(lines, \{ border: ... \})",
        )
    }
    b = get(BORDERS, string(border))
    if is_null(b) {
        bug("bad_option", "tui.box: border must be rounded, square, double or heavy, got {border}")
    }
    need_count("box", "padding", padding)
    need_count("box", "min_width", min_width)
    pad = padding
    rows = reduce(lines, fn(acc, l) acc + str.split(string(l), "\n"), [])

    # Content width = the widest line; a title must fit in the top edge too
    # (as "<h> <title> "), and min_width applies to the whole box.
    mut cw = 0
    for l in rows {
        cw = max([cw, vis(l)])
    }
    unless is_null(title) { cw = max([cw, vis(title) + 3 - 2 * pad]) }
    total = cw + 2 * pad + 2
    if min_width > total { cw = cw + (min_width - total) }
    inner = cw + 2 * pad

    top = if is_null(title) { b.tl + str.repeat(b.h, inner) + b.tr } else {
        label = b.h + " " + string(title) + " "
        b.tl + label + str.repeat(b.h, max([0, inner - vis(label)])) + b.tr
    }
    mut out = [top]
    for l in rows {
        out = push(out, b.v + spaces(pad) + pad_end(l, cw) + spaces(pad) + b.v)
    }
    out = push(out, b.bl + str.repeat(b.h, inner) + b.br)
    join(out, "\n")
}

# --- table -----------------------------------------------------------------

ALIGNS = ["left", "right", "center"]

fn align_cell(s, w, how) {
    if how == "right" {
        pad_start(s, w)
    } else if how == "center" {
        center(s, w)
    } else {
        pad_end(s, w)
    }
}

## `rows` as an aligned text table, one string with a line per row.
##
## `rows` is a list of lists; each cell is stringified, and a short row is
## padded with empty cells. Each column is as wide as its widest visible cell.
## `align` gives each column `"left"`, `"right"` or `"center"` (columns it
## does not cover are left-aligned); `header: true` draws a rule under the
## first row; `gap` separates columns.
##
## errors: `bug`/`bad_argument` when `rows` is not a list of lists;
## `bug`/`bad_option` for an unknown `align` value or a `header` that is not a
## Bool.
##
## example:
##   tui.table([["City", "Temp"], ["Nairobi", "26"]], align: ["left", "right"])
##   # City     Temp
##   # Nairobi    26
export fn table(rows, align = [], header = false, gap = "  ") {
    unless type_of(rows) == "list" and all(rows, fn(r) type_of(r) == "list") {
        bug("bad_argument", "tui.table: rows must be a list of lists, got {rows}")
    }
    if type_of(align) == "map" {
        bug(
            "bad_option",
            "tui.table: options are named arguments - write table(rows, header: true), not table(rows, \{ header: true \})",
        )
    }
    unless type_of(align) == "list" and all(align, fn(a) a in ALIGNS) {
        bug(
            "bad_option",
            "tui.table: align must be a list of \"left\", \"right\" or \"center\", got {align}",
        )
    }
    unless type_of(header) == "bool" {
        bug("bad_option", "tui.table: header must be a Bool, got {header}")
    }
    sep = string(gap)
    cells_of = map(rows, fn(r) map(r, fn(c) string(c)))
    ncols = reduce(cells_of, fn(acc, r) max([acc, len(r)]), 0)

    # Column widths = widest visible cell per column.
    mut widths = []
    for c in range(0, ncols) {
        mut w = 0
        for r in cells_of {
            if c < len(r) { w = max([w, vis(r[c])]) }
        }
        widths = push(widths, w)
    }

    mut out = []
    for (i, r) in enumerate(cells_of) {
        mut cells = []
        for c in range(0, ncols) {
            cell = if c < len(r) { r[c] } else { "" }
            how = if c < len(align) { align[c] } else { "left" }
            cells = push(cells, align_cell(cell, widths[c], how))
        }
        out = push(out, join(cells, sep))
        if header and i == 0 {
            rule = join(map(widths, fn(w) str.repeat("─", w)), sep)
            out = push(out, rule)
        }
    }
    join(out, "\n")
}
